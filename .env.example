# Optional integrations for AI-PCB-Engineer. NONE are required for V0.0.1.
# Copy to `.env` (gitignored) and fill in locally. Never paste real values into
# chat, docs, commits or .mcp.json.
#
# NOTE: The KiCad MCP server reads its own `.env` from the MCP server root
# (%USERPROFILE%\dev\tools\KiCAD-MCP-Server\.env), not from this workspace.
# This file documents the variable names only.

# JLCPCB Open Platform API (real-time part lookup; local snapshot works without it)
JLCPCB_APP_ID=
JLCPCB_API_KEY=
JLCPCB_API_SECRET=

# Digi-Key Product Information V4 (Production app required)
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=
# DIGIKEY_LOCALE_SITE=US
# DIGIKEY_LOCALE_LANGUAGE=en
# DIGIKEY_LOCALE_CURRENCY=USD
