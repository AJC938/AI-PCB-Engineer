# Normalize text; keep KiCad and manufacturing files byte-exact with LF endings
* text=auto
*.kicad_pro   text eol=lf
*.kicad_sch   text eol=lf
*.kicad_pcb   text eol=lf
*.kicad_sym   text eol=lf
*.kicad_mod   text eol=lf
*.kicad_dru   text eol=lf
*-lib-table   text eol=lf
*.json        text eol=lf
*.md          text eol=lf
# Gerber / drill / pick-and-place: treat as exact
*.gbr  -text
*.gtl  -text
*.gbl  -text
*.gto  -text
*.gbo  -text
*.gts  -text
*.gbs  -text
*.gtp  -text
*.gbp  -text
*.gm1  -text
*.drl  -text
*.gbrjob -text
# Binary assets
*.pdf  binary
*.png  binary
*.jpg  binary
*.step binary
*.wrl  binary
